# Modo nube = existen las dos variables VITE_ (públicas, van dentro de la página).
# Sin ellas la app funciona en modo local (demo y pruebas), guardando en el navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor (Vercel > Settings > Environment Variables). NUNCA con prefijo VITE_.
# La usa /api/usuarios para que el gerente cree usuarios.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
