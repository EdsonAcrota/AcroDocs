# Supabase (servidor / Vercel)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase (navegador; se usa para detectar modo nube)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Sincronización de estado (opcional)
# true = la app guarda el snapshot en Supabase y lo recupera al abrir
VITE_CLOUD_SYNC=false
# Secreto compartido entre la app y /api/state
VITE_APP_KEY=cambia-este-secreto
APP_KEY=cambia-este-secreto

# Bucket de archivos (se crea en schema.sql)
SUPABASE_BUCKET=adjuntos
